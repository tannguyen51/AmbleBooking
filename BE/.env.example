MONGODB_URI=mongodb://127.0.0.1:27017/Amble
PORT=5000
JWT_SECRET=your_jwt_secret
JWT_EXPIRES_IN=7d
OPENROUTER_API_KEY=your_openrouter_api_key
AI_MODELS=openai/gpt-4o-mini,anthropic/claude-3.5-haiku
VIETQR_BANK_CODE=your_bank_code
VIETQR_ACCOUNT_NUMBER=your_account_number
VIETQR_ACCOUNT_NAME=your_account_name
VIETQR_TEMPLATE=compact2
VIETQR_IMAGE_BASE=https://img.vietqr.io/image
PAYMENT_CONTENT_PREFIX=AMBLE
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_gmail_address
SMTP_PASS=your_gmail_app_password
SMTP_FROM=Amble <your_gmail_address>
APP_RESET_URL=amble://reset-password
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
GOOGLE_APP_REDIRECT=amble://auth/google
PAYOS_CLIENT_ID=your_payos_client_id
PAYOS_API_KEY=your_payos_api_key
PAYOS_CHECKSUM_KEY=your_payos_checksum_key
