# ============================================
# 📧 SMTP EMAIL CONFIGURATION
# ============================================
# Cấu hình gửi email (Gmail)

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@amble.com

# ============================================
# 🔐 JWT AUTHENTICATION
# ============================================

JWT_SECRET=your-super-secret-key-here-change-this
JWT_EXPIRES_IN=7d

# ============================================
# 🔄 PASSWORD RESET
# ============================================
# Link sẽ được gửi trong email (tuỳ chọn)
# Nếu để trống sẽ chỉ gửi mã

APP_RESET_URL=http://localhost:3000/reset

# ============================================
# 🗄️ DATABASE
# ============================================

MONGODB_URI=mongodb://localhost:27017/amble-db

# ============================================
# 🌐 SERVER
# ============================================

PORT=5000
NODE_ENV=development

# ============================================
# 📍 PAYMENT CONFIG (nếu có)
# ============================================

PAYMENT_KEY=your-payment-key-here
